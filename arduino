int ldrs[4] = {A0, A1, A2, A3};
bool estado_atual[4] = {false, false, false, false};
bool estado_anterior[4] = {false, false, false, false};
char direcoes[4] = {'c', 'd', 'b', 'e'};


void setup(){
  Serial.begin(9600);
};


void loop(){
  for (int i = 0; i<4; i++){
    int valor = analogRead(ldrs[i]);
    if(valor < 500){
      estado_atual[i] = true;
      if(estado_atual[i] != estado_anterior[i] && estado_anterior[i] == false){
        Serial.println(direcoes[i]);
        estado_anterior[i] = estado_atual[i];
      }
    }
    else{
      if(estado_atual[i] != false){
          estado_atual[i] = false;
          estado_anterior[i] = estado_atual[i];
      }
    }
  }
 
  delay(200);
};
