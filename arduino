int botoes[4] = {2, 3, 4, 5};
String direcoes[4] = {"c", "d", "b", "e"};

void setup()
{
  Serial.begin(9600);
  pinMode(2, INPUT);
  pinMode(3, INPUT);
  pinMode(4, INPUT);
  pinMode(5, INPUT);
}

void loop()
{
  for (int i=0; i<4; i++){
  	int valor = digitalRead(botoes[i]);
    if (valor == LOW){
    	Serial.println(direcoes[i]);
      	delay(200);
    }
  }
  delay(100);
}
